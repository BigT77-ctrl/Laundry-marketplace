# Copy this to .env in the admin-backend folder and fill in your real SMTP values.
# Example for Gmail (use an App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM="Laundry Market <you@gmail.com>"
# APP_BASE_URL=http://localhost:4001
# JWT_SECRET=change-this-secret

# Example for Brevo:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-login@brevo.com
# SMTP_PASS=your-brevo-password
# EMAIL_FROM="Laundry Market <no-reply@yourdomain.com>"

# Example for SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# EMAIL_FROM="Laundry Market <no-reply@yourdomain.com>"

# Common values used by the app
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=you@gmail.com
# MAIL_PASS=your-app-password
# MAIL_FROM="Laundry Market <you@gmail.com>"

# Optional:
# PORT=4001
# NODE_ENV=development
